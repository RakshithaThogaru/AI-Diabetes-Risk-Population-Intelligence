      <column caption='Diabetes Rate' datatype='real' default-format='p0.00%' name='[Calculation_0523139077648385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Diabetes_binary]) / COUNT([Age])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0523139388719107]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] = 1 THEN &quot;18-24&quot;&#13;&#10;ELSEIF [Age] = 2 THEN &quot;25-29&quot;&#13;&#10;ELSEIF [Age] = 3 THEN &quot;30-34&quot;&#13;&#10;ELSEIF [Age] = 4 THEN &quot;35-39&quot;&#13;&#10;ELSEIF [Age] = 5 THEN &quot;40-44&quot;&#13;&#10;ELSEIF [Age] = 6 THEN &quot;45-49&quot;&#13;&#10;ELSEIF [Age] = 7 THEN &quot;50-54&quot;&#13;&#10;ELSEIF [Age] = 8 THEN &quot;55-59&quot;&#13;&#10;ELSEIF [Age] = 9 THEN &quot;60-64&quot;&#13;&#10;ELSEIF [Age] = 10 THEN &quot;65-69&quot;&#13;&#10;ELSEIF [Age] = 11 THEN &quot;70-74&quot;&#13;&#10;ELSEIF [Age] = 12 THEN &quot;75-79&quot;&#13;&#10;ELSEIF [Age] = 13 THEN &quot;80+&quot;&#13;&#10;END' />
      </column>
