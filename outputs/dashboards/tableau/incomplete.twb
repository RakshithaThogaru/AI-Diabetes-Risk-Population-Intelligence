      <column caption='Any Healthcare' datatype='integer' name='[AnyHealthcare]' role='measure' type='quantitative' />
      <column aggregation='None' caption='BMI (bin)' datatype='integer' name='[BMI (bin)]' role='dimension' type='ordinal'>
